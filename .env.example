# =============================================================================
# Threat Identification System - Environment Configuration
# =============================================================================
# Copy to .env and fill in values before running.

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]
DEBUG=false
LOG_LEVEL=info

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=       # REQUIRED: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=threat_id
DB_USER=postgres
DB_PASSWORD=          # REQUIRED: set a strong password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Detection ────────────────────────────────────────────────────────────────
DETECTION_BACKEND=yolo       # yolo | onnx
DETECTION_MODEL_PATH=yolov5s.pt
DETECTION_CONFIDENCE_THRESHOLD=0.5
DETECTION_DEVICE=cpu         # cpu | cuda | cuda:0
DETECTION_THREAT_CATEGORIES=["knife","gun","rifle","pistol"]

# ── Recognition ──────────────────────────────────────────────────────────────
RECOGNITION_MODEL_NAME=Facenet
RECOGNITION_DISTANCE_METRIC=cosine
RECOGNITION_SIMILARITY_THRESHOLD=0.6
RECOGNITION_FACES_DIR=./data/faces

# ── Camera ───────────────────────────────────────────────────────────────────
CAMERA_DEFAULT_SOURCE=0
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480
CAMERA_FPS=30

# ── Alerting ─────────────────────────────────────────────────────────────────
ALERT_COOLDOWN_SECONDS=30
ALERT_ENABLED_CHANNELS=["websocket"]

# ── Email (optional) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=               # Use App Password, not account password
SMTP_SENDER=
SMTP_RECIPIENTS=[]

# ── Webhook (optional) ──────────────────────────────────────────────────────
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=10

# ── Observability ────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
AUDIT_LOG_ENABLED=true
AUDIT_RETENTION_DAYS=90
